# ============================================
# Admin Panel - Environment Variables Example
# ============================================
# Copy this file to .env and fill in your actual values.

# --------------------------------------------
# Application Configuration
# --------------------------------------------
VITE_APP_NAME=Your App Admin
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# --------------------------------------------
# API Configuration (Backend Server)
# --------------------------------------------
VITE_API_BASE_URL=https://api.example.com/api/v1

# --------------------------------------------
# Upload Configuration (Frontend Validation)
# --------------------------------------------
VITE_MAX_FILE_SIZE=5242880
VITE_MAX_FILES_PER_UPLOAD=10
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# --------------------------------------------
# Authentication Configuration
# --------------------------------------------
VITE_AUTH_TOKEN_KEY=your_admin_auth_token_key
VITE_SESSION_TIMEOUT=3600000

# --------------------------------------------
# Development Settings
# --------------------------------------------
VITE_DEV_PORT=3000
VITE_ENABLE_DEBUG_MODE=false

# --------------------------------------------
# Store Configuration
# --------------------------------------------
VITE_STORE_BASE_URL=https://store.example.com
